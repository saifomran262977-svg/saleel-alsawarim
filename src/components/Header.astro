---
// ============================================================
// صليل الصوارم — الشريط العلوي (طابع كلاسيكي رصين)
// ============================================================
interface Props {
  currentPath?: string;
  lang?: 'ar' | 'en';
}

const { currentPath = Astro.url.pathname, lang = 'ar' } = Astro.props;

const navItems = lang === 'ar'
  ? [
      { label: 'الرئيسية', href: '/' },
      { label: 'دروس', href: '/category/durus' },
      { label: 'مقالات', href: '/category/maqalat' },
      { label: 'سلاسل', href: '/series' },
      { label: 'فتاوى', href: '/category/fatawa' },
      { label: 'أثر ودليل', href: '/category/athar' },
      { label: 'عن الموقع', href: '/about' },
    ]
  : [
      { label: 'Home', href: '/en/' },
      { label: 'Lessons', href: '/en/category/lessons' },
      { label: 'Articles', href: '/en/category/articles' },
      { label: 'Series', href: '/en/category/series' },
      { label: 'Fatwas', href: '/en/category/fatwas' },
      { label: 'Evidence', href: '/en/category/evidence' },
      { label: 'About', href: '/en/about' },
    ];

const isActive = (href: string) => {
  if (href === '/' || href === '/en/') return currentPath === href;
  return currentPath.startsWith(href);
};

// تبديل مسار اللغة الحالي
const otherLangHref =
  lang === 'ar'
    ? '/en/' + currentPath.replace(/^\//, '')
    : currentPath.replace(/^\/en\/?/, '/') || '/';
---

<header class="site-header no-print" id="site-header">
  <div class="header-inner container">

    <!-- زر القائمة للموبايل -->
    <button
      class="menu-toggle"
      id="menu-toggle"
      aria-label="فتح القائمة"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <!-- الشعار -->
    <a href={lang === 'ar' ? '/' : '/en/'} class="site-logo" aria-label="الصفحة الرئيسية">
      <svg class="logo-mark" width="30" height="30" viewBox="0 0 40 40" aria-hidden="true">
        <!-- نجمة ثمانية إسلامية -->
        <g fill="none" stroke="currentColor" stroke-width="1.4">
          <rect x="8" y="8" width="24" height="24" transform="rotate(45 20 20)"/>
          <rect x="8" y="8" width="24" height="24"/>
          <circle cx="20" cy="20" r="3.2" fill="currentColor" stroke="none"/>
        </g>
      </svg>
      <span class="logo-text">
        <strong>صليل الصوارم</strong>
        <small>بالكتاب والسنة وعلى منهج السلف</small>
      </span>
    </a>

    <!-- القائمة الرئيسية -->
    <nav class="main-nav" aria-label="القائمة الرئيسية">
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.href} class={isActive(item.href) ? 'active' : ''}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- أدوات المستخدم -->
    <div class="header-tools">

      <!-- تبديل اللغة -->
      <a
        href={otherLangHref}
        class="tool-btn lang-switch"
        aria-label="تغيير اللغة"
        title={lang === 'ar' ? 'English' : 'العربية'}
      >
        {lang === 'ar' ? 'EN' : 'AR'}
      </a>

      <!-- البحث -->
      <button
        class="tool-btn"
        id="search-toggle"
        aria-label="بحث"
        title="بحث (Ctrl+K)"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="20" y1="20" x2="16.5" y2="16.5"></line>
        </svg>
      </button>

      <!-- تبديل الوضع -->
      <button
        class="tool-btn"
        id="theme-toggle"
        aria-label="تبديل الوضع"
        title="الوضع الليلي/النهاري"
      >
        <!-- شمس -->
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <line x1="12" y1="2" x2="12" y2="4"></line>
          <line x1="12" y1="20" x2="12" y2="22"></line>
          <line x1="4.2" y1="4.2" x2="5.6" y2="5.6"></line>
          <line x1="18.4" y1="18.4" x2="19.8" y2="19.8"></line>
          <line x1="2" y1="12" x2="4" y2="12"></line>
          <line x1="20" y1="12" x2="22" y2="12"></line>
          <line x1="4.2" y1="19.8" x2="5.6" y2="18.4"></line>
          <line x1="18.4" y1="5.6" x2="19.8" y2="4.2"></line>
        </svg>
        <!-- قمر -->
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- زر الدخول -->
      <button
        class="btn btn-outline btn-sm login-btn"
        id="login-btn"
        aria-label="الدخول بجوجل"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.48 10.92v3.28h7.84c-.24 1.84-.85 3.18-1.73 4.1-1.05 1.05-2.7 2.2-5.6 2.2-4.42 0-8.02-3.62-8.02-8.04s3.6-8.04 8.02-8.04c2.38 0 4.12.94 5.42 2.16l2.32-2.32C18.42 2.66 15.72 1.5 12.48 1.5 6.42 1.5 1.5 6.42 1.5 12.48S6.42 23.46 12.48 23.46c3.68 0 6.44-1.22 8.6-3.46 2.22-2.22 2.9-5.34 2.9-7.86 0-.52-.04-1.02-.12-1.48l-11.38.26z"/>
        </svg>
        <span class="login-text">دخول</span>
      </button>

      <!-- معلومات المستخدم (تظهر بعد الدخول) -->
      <div class="user-menu" id="user-menu" hidden>
        <button class="user-btn" id="user-btn" aria-label="حسابي">
          <img id="user-avatar" src="" alt="" width="30" height="30" />
          <span id="user-name"></span>
        </button>
        <div class="user-dropdown" id="user-dropdown" hidden>
          <a href="/profile">الملف الشخصي</a>
          <a href="/bookmarks">المحفوظات</a>
          <a href="/my-posts">منشوراتي</a>
          <hr />
          <button id="logout-btn">تسجيل الخروج</button>
        </div>
      </div>

    </div>
  </div>

  <!-- شريط تقدم القراءة -->
  <div class="reading-progress" id="reading-progress"></div>
</header>

<!-- نافذة البحث -->
<div class="search-overlay" id="search-overlay" hidden>
  <div class="search-modal">
    <button class="search-close" id="search-close" aria-label="إغلاق البحث">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.8"
           stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <h2>بحث في الموقع</h2>
    <form action="/search" method="get" class="search-form">
      <input
        type="search"
        name="q"
        id="search-input"
        placeholder="اكتب كلمة أو عبارة..."
        autocomplete="off"
        required
      />
      <button type="submit" class="btn btn-primary">ابحث</button>
    </form>
    <div class="search-suggestions">
      <span>أبواب مقترحة:</span>
      <a href="/search?q=التوحيد">التوحيد</a>
      <a href="/search?q=الصلاة">الصلاة</a>
      <a href="/search?q=الحديث">الحديث</a>
      <a href="/search?q=العقيدة">العقيدة</a>
    </div>
  </div>
</div>

<!-- القائمة الجانبية للموبايل -->
<div class="mobile-drawer-backdrop" id="drawer-backdrop" hidden></div>
<aside class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
  <div class="drawer-header">
    <span class="drawer-title">صليل الصوارم</span>
    <button class="drawer-close" id="drawer-close" aria-label="إغلاق">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.8"
           stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
  <nav class="drawer-nav">
    <ul>
      {navItems.map((item) => (
        <li>
          <a href={item.href} class={isActive(item.href) ? 'active' : ''}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="drawer-footer">
    <p class="text-sm text-muted">بالكتاب والسنة وعلى منهج السلف الصالح</p>
  </div>
</aside>

<style>
  /* ---------- الهيدر ---------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border);
    transition: box-shadow var(--t-base);
  }
  .site-header.scrolled { box-shadow: var(--shadow-sm); }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    height: var(--header-height);
  }

  /* ---------- الشعار ---------- */
  .site-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--text);
    flex-shrink: 0;
  }

  .logo-mark {
    color: var(--color-gold-dark);
    flex-shrink: 0;
    transition: color var(--t-base);
  }
  .site-logo:hover .logo-mark { color: var(--color-gold); }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .logo-text strong {
    font-family: var(--font-heading);
    font-size: 1.22rem;
    color: var(--text);
    font-weight: 700;
    letter-spacing: 0.3px;
  }

  .logo-text small {
    font-family: var(--font-body);
    font-size: 0.68rem;
    color: var(--text-muted);
    font-weight: 400;
    letter-spacing: 0.2px;
  }

  /* ---------- القائمة الرئيسية ---------- */
  .main-nav ul {
    display: flex;
    gap: 0.1rem;
  }

  .main-nav a {
    display: block;
    padding: 0.5rem 0.85rem;
    color: var(--text-soft);
    font-weight: 500;
    font-size: 0.93rem;
    border-radius: var(--radius-sm);
    transition: color var(--t-fast), background var(--t-fast);
    position: relative;
  }

  .main-nav a:hover {
    color: var(--color-primary);
    background: var(--bg-soft);
  }

  .main-nav a.active {
    color: var(--color-primary);
    font-weight: 700;
  }

  .main-nav a.active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    inset-inline: 0.85rem;
    height: 2px;
    background: var(--color-gold-dark);
  }

  /* ---------- أدوات المستخدم ---------- */
  .header-tools {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
  }

  .tool-btn {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-soft);
    transition: color var(--t-fast), background var(--t-fast);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.5px;
  }

  .tool-btn:hover {
    background: var(--bg-soft);
    color: var(--color-primary);
  }

  .lang-switch {
    font-family: var(--font-body);
    border: 1px solid var(--border);
  }

  /* تبديل أيقونة الشمس/القمر */
  .theme-toggle .icon-moon { display: none; }
  [data-theme="dark"] .theme-toggle .icon-sun { display: none; }
  [data-theme="dark"] .theme-toggle .icon-moon { display: block; }

  /* ---------- زر الدخول ---------- */
  .login-btn { gap: 0.4rem; }

  /* ---------- قائمة المستخدم ---------- */
  .user-menu { position: relative; }

  .user-btn {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.65rem 0.25rem 0.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    transition: border-color var(--t-fast);
  }
  .user-btn:hover { border-color: var(--color-gold-dark); }

  .user-btn img {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-xs);
  }

  .user-btn span {
    font-size: 0.85rem;
    font-weight: 600;
    max-width: 90px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .user-dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    inset-inline-end: 0;
    min-width: 200px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-md);
    padding: 0.35rem;
    z-index: 60;
  }

  .user-dropdown a,
  .user-dropdown button {
    display: block;
    width: 100%;
    text-align: start;
    padding: 0.55rem 0.8rem;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    color: var(--text-soft);
    transition: background var(--t-fast), color var(--t-fast);
  }

  .user-dropdown a:hover,
  .user-dropdown button:hover {
    background: var(--bg-soft);
    color: var(--color-primary);
  }

  .user-dropdown hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 0.35rem 0;
  }

  /* ---------- زر قائمة الموبايل ---------- */
  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    width: 38px;
    height: 38px;
    justify-content: center;
    align-items: center;
    border-radius: var(--radius-sm);
    transition: background var(--t-fast);
  }
  .menu-toggle:hover { background: var(--bg-soft); }

  .menu-toggle span {
    display: block;
    width: 20px;
    height: 1.5px;
    background: var(--text);
    transition: all var(--t-base);
  }

  /* ---------- شريط تقدم القراءة ---------- */
  .reading-progress {
    position: absolute;
    bottom: -1px;
    inset-inline-start: 0;
    height: 2px;
    width: 0;
    background: var(--color-gold-dark);
    transition: width 0.1s linear;
  }

  /* ---------- نافذة البحث ---------- */
  .search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(10, 10, 10, 0.55);
    z-index: 200;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 5rem 1rem 1rem;
  }

  .search-modal {
    background: var(--bg-elevated);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    max-width: 560px;
    width: 100%;
    position: relative;
    box-shadow: var(--shadow-lg);
  }

  .search-modal h2 {
    font-size: 1.35rem;
    margin-bottom: 1rem;
  }

  .search-close {
    position: absolute;
    top: 0.85rem;
    inset-inline-end: 0.85rem;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    transition: all var(--t-fast);
  }
  .search-close:hover {
    background: var(--bg-soft);
    color: var(--danger);
  }

  .search-form {
    display: flex;
    gap: 0.5rem;
  }
  .search-form input { flex: 1; }

  .search-suggestions {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.85rem;
  }
  .search-suggestions > span {
    color: var(--text-muted);
  }
  .search-suggestions a {
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-sm);
    background: var(--bg-soft);
    color: var(--text-soft);
    border: 1px solid var(--border);
  }
  .search-suggestions a:hover {
    background: var(--color-primary);
    color: #f7f3ea;
    border-color: var(--color-primary);
  }

  /* ---------- قائمة الموبايل الجانبية ---------- */
  .mobile-drawer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(10, 10, 10, 0.5);
    z-index: 90;
  }

  .mobile-drawer {
    position: fixed;
    top: 0;
    inset-inline-start: 0;
    width: 290px;
    max-width: 85vw;
    height: 100vh;
    background: var(--bg-elevated);
    border-inline-end: 1px solid var(--border);
    z-index: 100;
    transform: translateX(-100%);
    transition: transform var(--t-base);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  [dir="rtl"] .mobile-drawer { transform: translateX(100%); }
  .mobile-drawer.open { transform: translateX(0); }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.15rem;
    border-bottom: 1px solid var(--border);
  }

  .drawer-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text);
  }

  .drawer-close {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
  }
  .drawer-close:hover {
    background: var(--bg-soft);
    color: var(--danger);
  }

  .drawer-nav {
    flex: 1;
    padding: 0.75rem;
  }

  .drawer-nav a {
    display: block;
    padding: 0.75rem 0.9rem;
    border-radius: var(--radius-sm);
    color: var(--text-soft);
    font-weight: 500;
    transition: all var(--t-fast);
  }

  .drawer-nav a:hover,
  .drawer-nav a.active {
    background: var(--bg-soft);
    color: var(--color-primary);
  }

  .drawer-footer {
    padding: 1rem 1.15rem;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  /* ---------- التجاوب ---------- */
  @media (max-width: 960px) {
    .main-nav { display: none; }
    .menu-toggle { display: flex; }
  }

  @media (max-width: 640px) {
    .login-text { display: none; }
    .login-btn { padding: 0.5rem 0.7rem; }
    .logo-text small { display: none; }
    .logo-text strong { font-size: 1.05rem; }
    .lang-switch { width: 34px; height: 34px; }
  }
</style>

<script>
  // ============================================================
  // سلوك الهيدر
  // ============================================================
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const drawer = document.getElementById('mobile-drawer');
  const backdrop = document.getElementById('drawer-backdrop');
  const drawerClose = document.getElementById('drawer-close');

  // ظل عند التمرير + شريط تقدم القراءة
  const progress = document.getElementById('reading-progress');
  const onScroll = () => {
    if (header) header.classList.toggle('scrolled', window.scrollY > 20);
    if (progress) {
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      const pct = max > 0 ? (h.scrollTop / max) * 100 : 0;
      progress.style.width = pct + '%';
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // فتح/إغلاق قائمة الموبايل
  const openDrawer = () => {
    if (!drawer || !backdrop) return;
    drawer.classList.add('open');
    drawer.setAttribute('aria-hidden', 'false');
    backdrop.hidden = false;
    document.body.style.overflow = 'hidden';
  };
  const closeDrawer = () => {
    if (!drawer || !backdrop) return;
    drawer.classList.remove('open');
    drawer.setAttribute('aria-hidden', 'true');
    backdrop.hidden = true;
    document.body.style.overflow = '';
  };

  toggle?.addEventListener('click', openDrawer);
  drawerClose?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);

  // نافذة البحث
  const searchToggle = document.getElementById('search-toggle');
  const searchOverlay = document.getElementById('search-overlay');
  const searchClose = document.getElementById('search-close');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;

  const openSearch = () => {
    if (!searchOverlay) return;
    searchOverlay.hidden = false;
    setTimeout(() => searchInput?.focus(), 40);
  };
  const closeSearch = () => {
    if (!searchOverlay) return;
    searchOverlay.hidden = true;
  };

  searchToggle?.addEventListener('click', openSearch);
  searchClose?.addEventListener('click', closeSearch);
  searchOverlay?.addEventListener('click', (e) => {
    if (e.target === searchOverlay) closeSearch();
  });

  // اختصارات لوحة المفاتيح
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { closeSearch(); closeDrawer(); }
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
  });

  // تبديل الوضع الليلي/النهاري
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    (window as any).toggleTheme?.();
  });

  // قائمة المستخدم المنسدلة
  const userBtn = document.getElementById('user-btn');
  const userDropdown = document.getElementById('user-dropdown');
  userBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (userDropdown) userDropdown.hidden = !userDropdown.hidden;
  });
  document.addEventListener('click', () => {
    if (userDropdown) userDropdown.hidden = true;
  });
</script>
